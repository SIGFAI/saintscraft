--- a/link/src/dllmain.cpp
+++ b/link/src/dllmain.cpp
@@ -1,13 +1,17 @@
 // SRTTR.exe imports DirectInput8Create from dinput8.dll, so Windows loads this proxy from the game
 // folder first. It forwards that call to the real system DLL and starts the link.
 #include "compositor.h"
+#ifdef MCSR3_DEVCHAN
 #include "devchan.h"
+#endif
 #include "ground.h"
 #include "input.h"
 #include "link.h"
 #include "log.h"
 #include "lua.h"
+#ifdef MCSR3_DEVCHAN
 #include "luadev.h"
+#endif
 #include "mainloop.h"
 #include "sr3.h"
 
@@ -48,8 +52,10 @@ namespace
 		}
 		if (lua::Init())
 		{
+#ifdef MCSR3_DEVCHAN  // SIGF build: the Lua dev channel (mcsr3\exec\*.lua, mc_write/mc_call) is compiled out
 			luadev::Install();
 			devchan::Start();
+#endif
 			mainloop::OnTick(lua::Tick);
 		}
 		if (sr3::Init())
