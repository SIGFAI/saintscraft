diff --git a/link/CMakeLists.txt b/link/CMakeLists.txt
index 075f4ff..daf3d26 100644
--- a/link/CMakeLists.txt
+++ b/link/CMakeLists.txt
@@ -14,9 +14,17 @@ FetchContent_MakeAvailable(minhook)
 set(SKYCRAFT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../skycraft" CACHE PATH "SkyCraft checkout (tools/fetch_sources.sh)")
 
 file(GLOB SOURCES CONFIGURE_DEPENDS src/*.cpp)
+# SIGF build: the Lua dev channel (devchan.cpp, luadev.cpp) is left out unless MCSR3_DEVCHAN=ON
+option(MCSR3_DEVCHAN "Build the Lua dev channel (mcsr3/exec/*.lua)" OFF)
+if(NOT MCSR3_DEVCHAN)
+	list(FILTER SOURCES EXCLUDE REGEX "/(devchan|luadev)[.]cpp$")
+endif()
 add_library(dinput8 SHARED ${SOURCES})
 target_include_directories(dinput8 PRIVATE src "${SKYCRAFT_DIR}/protocol")
 target_compile_definitions(dinput8 PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX _CRT_SECURE_NO_WARNINGS)
+if(MCSR3_DEVCHAN)
+	target_compile_definitions(dinput8 PRIVATE MCSR3_DEVCHAN)
+endif()
 target_compile_options(dinput8 PRIVATE /W4 /wd4100 /utf-8 /Zi)
 target_link_options(dinput8 PRIVATE /DEBUG /OPT:REF /OPT:ICF)
 target_link_libraries(dinput8 PRIVATE minhook d3d11 dxgi d3dcompiler)
diff --git a/link/src/dllmain.cpp b/link/src/dllmain.cpp
