{
  "id": "sigf/saintscraft",
  "version": "0.1.0",
  "name": "SaintsCraft",
  "tagline": "Real Minecraft inside Saints Row: The Third Remastered: walk Steelport as Steve, build, swing swords at the Saints' enemies and blow up TNT, while SR3 keeps its cars.",
  "how_to_play": [
    "Play Steve in first person on Saints Row: The Third Remastered's streets with Minecraft's hotbar, blocks, swords and TNT; Saints Row keeps the cars and camera.",
    "Press Play: Minecraft starts first and opens a void creative world by itself; leave its window open. Then Saints Row starts: load your save.",
    "Minecraft links up by itself: its hotbar shows at the bottom of the screen.",
    "F7 switches between Minecraft mode and Saints Row mode (always Saints Row in a vehicle); use Saints Row mode for cars, doors, missions and the crib.",
    "Minecraft mode: WASD, Space (double-tap to fly), mouse to break/place, 1-9 hotbar, E inventory, O Minecraft menu, Esc pause."
  ],
  "kind": "passthrough",
  "games": [
    {
      "game": "saintsrow3",
      "role": "host",
      "label": "Saints Row: The Third Remastered",
      "engine": "Saints Row: The Third Remastered (DX11) + dinput8.dll proxy (C++, MinHook)",
      "apps": {
        "steam": "978300"
      },
      "runtime": "Steam build of 2024-08 only (SRTTR.exe 21,474,968 bytes); Epic and GOG builds are not supported"
    },
    {
      "game": "minecraft",
      "role": "guest",
      "label": "Minecraft",
      "engine": "Minecraft Java 26.3 + Fabric mod passthrough (Java)",
      "mc": "26.3",
      "loader": "fabric@0.19.5",
      "java": "25"
    }
  ],
  "requires": [
    {
      "id": "fabric-loader",
      "version": "0.19.5"
    },
    {
      "id": "fabric-api",
      "version": "0.161.0+26.3",
      "note": "in the Minecraft pack (downloaded from Modrinth)"
    }
  ],
